ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# V1 execution is paper-only. It requires both flags below exactly as shown.
PAPER_TRADING=true
PAPER_EXECUTION_ENABLED=false
LIVE_TRADING_ENABLED=false

INITIAL_EQUITY=10000
RISK_PER_TRADE=0.0035
MAX_SYMBOL_EXPOSURE=0.20
MAX_TOTAL_EXPOSURE=0.35
DAILY_LOSS_LIMIT=0.01
MAX_DRAWDOWN=0.08

# Additional V1 paper-order cap: no new order targets more than 10% of equity.
PAPER_MAX_ORDER_EQUITY_PCT=0.10

ASSUMED_FEE_BPS=10
ASSUMED_SLIPPAGE_BPS=5
